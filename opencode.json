{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      }
    },
    "github-copilot": {}
  },
  "disabled_providers": [],
  "model": "deepseek/deepseek-flash",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  },
  "permission": {
    "edit": {
      "raw/**": "deny",
      "*": "allow"
    },
    "bash": {
      "git push": "ask",
      "rm -rf *": "deny",
      "*": "allow"
    },
    "webfetch": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "docs/specs/constitution.md"
  ]
}