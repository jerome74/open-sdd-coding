{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "deepseek": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "compatibility": {
        "supportsPromptCacheKey": true
      },
      "models": {
        "deepseek-flash": {
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          }
        }
      }
    },
    "github-copilot": {}
  },
  "plugins": [
    {
      "package": "./.opencode/plugins/dcp",
      "options": {}
    }
  ],
  "mcp": {
    "servers": {
      "tavily": {
        "type": "local",
        "command": ["npx", "-y", "tavily-mcp"],
        "disabled": true
      },
      "fetch": {
        "type": "local",
        "command": ["uvx", "mcp-server-fetch"],
        "disabled": true
      },
      "docs": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "edit",
      "resource": "raw/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "git push",
      "effect": "ask"
    },
    {
      "action": "bash",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "instructions": [
    "AGENTS.md"
  ]
}