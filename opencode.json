{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "setCacheKey": true
      },
      "models": {
        "deepseek-flash": {
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          }
        }
      }
    },
    "github-copilot": {}
  },
  "disabled_providers": [],
  "model": "deepseek/deepseek-flash",
  "plugin": ["@keakon/opencode-dcp@1.2.8", "agent-cache-optimizer@0.6.1"],
  "mcp": {
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp"],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": false
    },
    "docs": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  },
  "permission": {
    "edit": {
      "raw/**": "deny",
      "*": "allow"
    },
    "bash": {
      "git push": "ask",
      "rm -rf *": "deny",
      "*": "allow"
    },
    "webfetch": "allow"
  },
  "instructions": [
    "AGENTS.md"
  ]
}